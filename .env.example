# ============================================================
# Ashish Rewaskar Portfolio — Environment Variables
# ============================================================
# NEVER commit this file to git. It is listed in .gitignore.
# Copy this file, rename to .env, and fill in your real keys.
# ============================================================

# --- Server ---
PORT=3000

# --- Resend (Email API) ---
# Get your key from: https://resend.com → API Keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# --- Email Routing ---
# The email address where you want to RECEIVE form submissions
TO_EMAIL=ashishrewaskar45@gmail.com

# The sender address shown in the email
# For testing: use "onboarding@resend.dev" (Resend sandbox)
# For production: use a verified domain email e.g. "portfolio@yourdomain.com"
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Ashish Portfolio

# --- Twilio (SMS API) ---
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (from Twilio console, e.g. +12055559876)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Your mobile number to receive SMS alerts (must be verified in Twilio trial)
TO_PHONE=+919130321429
