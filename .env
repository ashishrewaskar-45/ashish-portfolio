# ============================================================
# Ashish Rewaskar Portfolio — Environment Variables
# ============================================================
# NEVER commit this file to git. It is listed in .gitignore.
# Fill in your real API keys below.
# ============================================================

# --- Server ---
PORT=3000

# --- Resend (Email API) ---
# Get your key from: https://resend.com → API Keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# --- Email Routing ---
TO_EMAIL=ashishrewaskar45@gmail.com
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Ashish Portfolio

# --- Twilio (SMS API) ---
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Your mobile number to receive SMS alerts
TO_PHONE=+919130321429
